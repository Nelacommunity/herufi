# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase project → Connect → Session pooler connection string (used by `pnpm db:push` / `pnpm db:seed` only)
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Public site URL (used for SEO, sitemap, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" after enabling Google in Supabase → Authentication → Providers
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Set to "true" if your Supabase plan includes Image Transformations (Pro and above)
NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=false

# Snippe payments (server only; Dashboard → Settings → API Keys / Webhooks)
SNIPPE_API_KEY=snp_your_api_key
SNIPPE_WEBHOOK_SECRET=your-webhook-signing-secret
# Register this endpoint in the Snippe dashboard: <NEXT_PUBLIC_SITE_URL>/api/snippe/webhook (must be https)
# Optional override for local dev: a public https tunnel URL (e.g. ngrok) ending in /api/snippe/webhook
SNIPPE_WEBHOOK_URL=

# Tegasms SMS (server only; sms.tegasms.co.tz → Profile → My Account → API key)
TEGASMS_API_KEY=your-tegasms-token
# Must be an APPROVED sender ID (≤11 alphanumeric chars), otherwise sends fail with 401/400
TEGASMS_SENDER_ID=HERUFI

# Business details shown on policy/contact pages and in SMS (all optional; defaults live in src/lib/business.ts)
NEXT_PUBLIC_SUPPORT_EMAIL=hello@your-domain.co.tz
NEXT_PUBLIC_SUPPORT_PHONE=+255 7XX XXX XXX
NEXT_PUBLIC_BUSINESS_ADDRESS=Your street, Dar es Salaam, Tanzania
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_REG_NUMBER=
NEXT_PUBLIC_BUSINESS_TIN=
NEXT_PUBLIC_BUSINESS_VRN=
