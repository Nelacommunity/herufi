# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase project → Connect → Session pooler connection string (used by `pnpm db:push` / `pnpm db:seed` only)
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Public site URL (used for SEO, sitemap, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Snippe payments (server only; Snippe dashboard → Settings → API Keys / Webhooks) -------------
SNIPPE_API_KEY=snp_your_api_key
SNIPPE_WEBHOOK_SECRET=your-webhook-signing-secret
# Register this endpoint in the Snippe dashboard: <NEXT_PUBLIC_SITE_URL>/api/snippe/webhook (must be https).
# Optional override for local dev: a public https tunnel URL (e.g. ngrok) ending in /api/snippe/webhook
SNIPPE_WEBHOOK_URL=

# --- SEO -------------------------------------------------------------------------------------
# Official social / business profile URLs, comma-separated (used as schema.org sameAs).
# e.g. https://www.instagram.com/herufi.tz,https://www.tiktok.com/@herufi.tz,https://www.facebook.com/herufi.tz
NEXT_PUBLIC_SOCIAL_LINKS=

# Set to "true" after enabling Google in Supabase → Authentication → Providers
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Set to "true" if your Supabase plan includes Image Transformations (Pro and above)
NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=false

# --- AI product import (Admin → Products → AI import) -------------------------------------------
# Server-only. Get a key at https://aistudio.google.com/apikey . Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional: Gemini model (default gemini-2.5-flash).
GEMINI_MODEL=
# Optional: markup on the yuan price (default 3), rounding step in TSh (default 500), stock per option (default 10).
AI_PRICE_MULTIPLIER=3
AI_PRICE_ROUNDING=500
AI_DEFAULT_STOCK=10
# Optional safety net: yuan→shilling rate used only if the live rate can't be fetched.
CNY_TZS_RATE=400
